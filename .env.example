# Copy to .env (never commit .env; this repo is public).

# ---- Database: pick ONE -------------------------------------------------
# a) Shared Supabase: Project Settings -> Database -> Connect -> "Session pooler" URI.
#    (The direct connection is IPv6-only and often fails from Docker.)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# b) Local Postgres in Docker: leave DATABASE_URL commented out and run `make up-local`.

# ---- LLM provider (optional) ----------------------------------------------
# Fill in ONE provider. Azure wins if both are set. With neither, the pipeline
# runs in "heuristic mode" so the app still works.

# OpenAI (platform.openai.com -> API keys)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Apertus, the Swiss open LLM, on Swisscom (optional extra model in the picker).
# Hackathon key: https://keymaker.ai-weeks.ch/ -> Swisscom -> your Luma email.
# Only the key is required; the URL defaults to the Swiss {ai} Weeks product.
# Limits: 5 requests/s, 10M input / 2.5M output tokens.
APERTUS_API_KEY=
# APERTUS_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
# APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Models offered in the UI's model picker. The first one is the default unless
# OPENAI_CHAT_MODEL / AZURE_OPENAI_CHAT_DEPLOYMENT is set.
LLM_MODEL_CHOICES=gpt-5.4-mini,gpt-5.5,gpt-6-sol,gpt-4.1-mini

# Leave empty for the model's default (some reasoning models reject other values).
LLM_TEMPERATURE=

CORS_ORIGINS=http://localhost:5173
